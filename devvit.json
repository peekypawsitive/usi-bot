{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "trials998",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Mop comments",
        "description": "Remove this comment and all child comments. This might take a few seconds to run.",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/mop-comment"
      },
      {
        "label": "Mop post comments",
        "description": "Remove all comments of this post. This might take a few seconds to run.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/mop-post"
      }
    ]
  },
  "forms": {
    "mopComment": "/internal/form/mop-comment-submit",
    "mopPost": "/internal/form/mop-post-submit"
  },
  "triggers": {
    "onCommentCreate": "/internal/triggers/on-comment-create",
    "onAppInstall": "/internal/triggers/on-app-install",
    "onAppUpgrade": "/internal/triggers/on-app-upgrade"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "permissions": {
    "reddit": true,
    "http": {
      "enable": true,
      "domains": ["www.googleapis.com", "api.spotify.com", "accounts.spotify.com"]
    }
  },
  "dev": {
    "subreddit": "trials998_dev"
  },
  "settings": {
    "global": {
      "youtube-api-key": {
        "type": "string",
        "label": "YouTube Data API Key",
        "isSecret": true
      },
      "spotify-client-id": {
        "type": "string",
        "label": "Spotify clientid",
        "isSecret": true
      },
      "spotify-client-secret": {
        "type": "string",
        "label": "Spotify clientsecret",
        "isSecret": true
      }
    }
  }
}
